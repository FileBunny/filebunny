# FileBunny behind Caddy. Set FILEBUNNY_DOMAIN (e.g. filebunny.eu);
# the default "localhost" uses Caddy's local CA for development.
#
# Privacy (see docs/security-review.md):
# - There is deliberately no `log` directive in the site block, so Caddy
#   writes no access log. Never add one: access logs contain client IPs.
# - Caddy's error log includes the request (client IP, headers with the
#   delete token, URI with the file ID); the filter below removes those.
{
	admin off
	# The local CA (localhost, FILEBUNNY_TLS=internal) cannot and need not
	# install its root in the read-only container.
	skip_install_trust
	log {
		level WARN
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>uri delete
			request>tls delete
		}
	}
}

# Certificates (FILEBUNNY_TLS): "auto" gets one from a public CA (Let's
# Encrypt) and needs ports 80 and 443 reachable for the challenge;
# "internal" uses Caddy's own CA, for a test server on an internal name
# (trust its root certificate in the browser). "localhost" always uses
# the local CA. Any other value stops Caddy ("File to import not found").
# TLS 1.3 only (Mozilla's "modern" profile): no TLS 1.2 fallback, so
# no downgrade to it and forward secrecy also for resumed sessions.
(tls-auto) {
	tls {
		protocols tls1.3
	}
}
(tls-internal) {
	tls internal {
		protocols tls1.3
	}
}

# FILEBUNNY_WWW_REDIRECT=true also serves www.<domain> and redirects it
# to the domain. Only switch it on when www has a DNS record, or getting
# its certificate keeps failing.
(www-false) {
}
(www-true) {
	www.{$FILEBUNNY_DOMAIN:localhost} {
		import tls-{$FILEBUNNY_TLS:auto}
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			-Server
		}
		redir https://{$FILEBUNNY_DOMAIN:localhost}{uri} permanent
	}
}
import www-{$FILEBUNNY_WWW_REDIRECT:false}

{$FILEBUNNY_DOMAIN:localhost} {
	import tls-{$FILEBUNNY_TLS:auto}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /api/* {
		# The backend enforces the real limit and answers with JSON;
		# this only stops absurd bodies early.
		request_body {
			max_size 110MiB
		}
		# The backend sets its own CSP and framing headers.
		reverse_proxy backend:8080 {
			# No forwarding headers: the backend gets the visitor's
			# address only in X-FileBunny-Client, set here from the
			# connection (a value the client sends is replaced). The
			# backend only hashes it for rate limiting and never stores
			# or logs it (internal/ratelimit).
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -Forwarded
			header_up X-FileBunny-Client {remote_host}
		}
	}

	# security.txt and its key (deploy/well-known): plain text, and a
	# missing file is a 404, not the app.
	handle /.well-known/* {
		header Content-Type "text/plain; charset=utf-8"
		root * /srv
		file_server
	}

	handle {
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://keys.openpgp.org https://filebin.net https://storage.filebin.net; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(self), microphone=(), geolocation=(), interest-cohort=()"
			Cross-Origin-Opener-Policy "same-origin"
		}
		encode zstd gzip
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
