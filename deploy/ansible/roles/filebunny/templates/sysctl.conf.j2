# Managed by deploy/ansible.
# SYN floods: answer with cookies instead of filling the backlog.
net.ipv4.tcp_syncookies = 1
# No ICMP redirects or source routing: nobody may change our routes.
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
# Kernel addresses and the kernel log only for root (harder local exploits).
kernel.kptr_restrict = 2
kernel.dmesg_restrict = 1
kernel.unprivileged_bpf_disabled = 1
# Only after a first break-in as an ordinary user: a process may trace
# only its own children (not other processes of the same user, such as an
# SSH session), no tty line discipline modules loaded on demand by
# unprivileged users (the route of several kernel exploits), and no
# writing to someone else's FIFO in a sticky directory such as /tmp.
kernel.yama.ptrace_scope = 1
dev.tty.ldisc_autoload = 0
fs.protected_fifos = 2
