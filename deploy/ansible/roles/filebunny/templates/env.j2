# Managed by deploy/ansible (variables in your inventory); used by
# scripts/deploy.sh for every release.
FILEBUNNY_DOMAIN={{ filebunny_domain }}
FILEBUNNY_TLS={{ filebunny_tls }}
FILEBUNNY_WWW_REDIRECT={{ filebunny_www_redirect | string | lower }}
FILEBUNNY_MAX_TOTAL_SIZE={{ filebunny_max_total_size }}
{% if filebunny_smtp_file | length > 0 and filebunny_share_mail %}
FILEBUNNY_SMTP=/etc/filebunny/smtp.json
{% endif %}
{% for key, value in filebunny_env | dictsort %}
{{ key }}={{ value }}
{% endfor %}
