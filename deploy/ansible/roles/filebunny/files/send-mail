#!/usr/bin/python3 -I
"""Sends one mail for filebunny-monitor; runs as the user filebunny-mail.

Reads {"relay": {...}, "message": {...}} on stdin (the relay as in the
backend's SMTP file). TLS always, certificates verified: port 465 (or
"implicit_tls") TLS from the start, otherwise STARTTLS. No plain SMTP.
"""

import email.message
import email.utils
import json
import smtplib
import ssl
import sys

data = json.load(sys.stdin)
relay, msg_in = data["relay"], data["message"]

msg = email.message.EmailMessage()
msg["From"] = msg_in["from"]
msg["To"] = msg_in["to"]
msg["Subject"] = msg_in["subject"]
msg["Date"] = email.utils.formatdate(localtime=True)
msg["Message-ID"] = email.utils.make_msgid(domain=msg_in["domain"])
msg.set_content(msg_in["body"])

ctx = ssl.create_default_context()
port = int(relay.get("port", 587))
try:
    if port == 465 or relay.get("implicit_tls"):
        server = smtplib.SMTP_SSL(relay["host"], port, context=ctx, timeout=60)
    else:
        server = smtplib.SMTP(relay["host"], port, timeout=60)
        server.starttls(context=ctx)
    with server:
        server.login(relay["username"], relay["password"])
        server.send_message(msg)
except (OSError, smtplib.SMTPException) as e:
    # Never the password: smtplib's errors hold the server's answer only.
    sys.exit(f"{type(e).__name__}: {e}")
